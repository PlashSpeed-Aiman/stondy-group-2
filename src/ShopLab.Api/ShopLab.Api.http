@host = http://localhost:5080

### ── Diagnostics ───────────────────────────────────────────
GET {{host}}/api/diagnostics/requests
###
DELETE {{host}}/api/diagnostics/requests
###
GET {{host}}/api/diagnostics/indexes
###
GET {{host}}/api/diagnostics/missing-indexes
###
POST {{host}}/api/diagnostics/cold-cache

### ── Lab 1: N+1 ────────────────────────────────────────────
GET {{host}}/api/labs/1-n-plus-one/naive?take=50
###
GET {{host}}/api/labs/1-n-plus-one/include?take=50
###
GET {{host}}/api/labs/1-n-plus-one/projection?take=50
###
GET {{host}}/api/labs/1-n-plus-one/projection?take=50&explain=true

### ── Lab 2: single vs split ────────────────────────────────
GET {{host}}/api/labs/2-split-query/single?take=3
###
GET {{host}}/api/labs/2-split-query/split?take=3
###
# Careful: the hottest products produce a very large single-query result
GET {{host}}/api/labs/2-split-query/single?take=1&hot=true
###
GET {{host}}/api/labs/2-split-query/split?take=1&hot=true
###
GET {{host}}/api/labs/2-split-query/filtered-include?take=3&hot=true

